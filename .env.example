# SIDDIQIYA Apparel — environment template. Copy to .env for local tooling; never commit real values.
# The website itself is static: only PUBLIC values are compiled into it (assets/js/sb.js).

# --- Public (safe in the browser) ---
SUPABASE_URL=https://ketzuhfolwhofrnliirf.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional Google Analytics 4 Measurement ID, read by `node src/build.mjs`
GA_MEASUREMENT_ID=

# --- Server-side secrets: set with `supabase secrets set …` for the apparel-mailer Edge Function ---
# Never put these in the website, the repository or a chat message.
RESEND_API_KEY=
MAIL_FROM="SIDDIQIYA Apparel <sales@your-verified-domain>"
MAIL_REPLY_TO=
MAILER_SECRET=generate-a-long-random-string
# SUPABASE_SERVICE_ROLE_KEY is injected automatically inside Edge Functions — do not copy it anywhere.
